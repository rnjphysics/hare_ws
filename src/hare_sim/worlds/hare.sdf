<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hare_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hare">
      <pose>0 0 0.28 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>80</mass>
          <inertia>
            <ixx>8.0</ixx>
            <iyy>12.0</iyy>
            <izz>15.0</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.7 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.7 0.35</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.25 0.35 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_front_wheel">
        <pose>0.42 0.42 -0.12 1.5708 0 0</pose>
        <inertial>
          <mass>4</mass>
          <inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry>
        </visual>
      </link>
      <link name="left_middle_wheel">
        <pose>0 0.42 -0.12 1.5708 0 0</pose>
        <inertial><mass>4</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></visual>
      </link>
      <link name="left_rear_wheel">
        <pose>-0.42 0.42 -0.12 1.5708 0 0</pose>
        <inertial><mass>4</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></visual>
      </link>
      <link name="right_front_wheel">
        <pose>0.42 -0.42 -0.12 1.5708 0 0</pose>
        <inertial><mass>4</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></visual>
      </link>
      <link name="right_middle_wheel">
        <pose>0 -0.42 -0.12 1.5708 0 0</pose>
        <inertial><mass>4</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></visual>
      </link>
      <link name="right_rear_wheel">
        <pose>-0.42 -0.42 -0.12 1.5708 0 0</pose>
        <inertial><mass>4</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></visual>
      </link>

      <joint name="left_front_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_front_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="left_middle_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_middle_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="left_rear_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_rear_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="right_front_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_front_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="right_middle_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_middle_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="right_rear_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_rear_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_front_wheel_joint</left_joint>
        <left_joint>left_middle_wheel_joint</left_joint>
        <left_joint>left_rear_wheel_joint</left_joint>
        <right_joint>right_front_wheel_joint</right_joint>
        <right_joint>right_middle_wheel_joint</right_joint>
        <right_joint>right_rear_wheel_joint</right_joint>
        <wheel_separation>0.84</wheel_separation>
        <wheel_radius>0.22</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <odom_topic>odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>chassis</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
